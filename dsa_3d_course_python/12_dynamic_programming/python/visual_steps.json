{
  "world": "12_dynamic_programming",
  "description": "Visualization steps for dynamic programming algorithms",
  "algorithms": [
    {
      "algorithm": "fibonacci_tabulation",
      "name": "Fibonacci (Tabulation)",
      "complexity": "O(n)",
      "n": 7,
      "steps": [
        {
          "step": 1,
          "description": "Initialize DP table",
          "action": "init",
          "table": [0, 1, null, null, null, null, null, null],
          "visual_note": "Row of 8 tiles, first two filled"
        },
        {
          "step": 2,
          "description": "F(2) = F(1) + F(0) = 1 + 0 = 1",
          "action": "fill",
          "cell": 2,
          "value": 1,
          "dependencies": [0, 1],
          "table": [0, 1, 1, null, null, null, null, null],
          "visual_note": "Tile 2 lights up"
        },
        {
          "step": 3,
          "description": "F(3) = F(2) + F(1) = 1 + 1 = 2",
          "action": "fill",
          "cell": 3,
          "value": 2,
          "dependencies": [1, 2],
          "table": [0, 1, 1, 2, null, null, null, null],
          "visual_note": "Tile 3 lights up"
        },
        {
          "step": 4,
          "description": "F(4) = F(3) + F(2) = 2 + 1 = 3",
          "action": "fill",
          "cell": 4,
          "value": 3,
          "dependencies": [2, 3],
          "table": [0, 1, 1, 2, 3, null, null, null],
          "visual_note": "Tile 4 lights up"
        },
        {
          "step": 5,
          "description": "F(5) = F(4) + F(3) = 3 + 2 = 5",
          "action": "fill",
          "cell": 5,
          "value": 5,
          "dependencies": [3, 4],
          "table": [0, 1, 1, 2, 3, 5, null, null],
          "visual_note": "Tile 5 lights up"
        },
        {
          "step": 6,
          "description": "F(6) = F(5) + F(4) = 5 + 3 = 8",
          "action": "fill",
          "cell": 6,
          "value": 8,
          "dependencies": [4, 5],
          "table": [0, 1, 1, 2, 3, 5, 8, null],
          "visual_note": "Tile 6 lights up"
        },
        {
          "step": 7,
          "description": "F(7) = F(6) + F(5) = 8 + 5 = 13",
          "action": "fill",
          "cell": 7,
          "value": 13,
          "dependencies": [5, 6],
          "table": [0, 1, 1, 2, 3, 5, 8, 13],
          "visual_note": "Final tile lights up"
        },
        {
          "step": 8,
          "description": "Complete: F(7) = 13",
          "action": "complete",
          "result": 13,
          "visual_note": "Answer tile glows brightest"
        }
      ]
    },
    {
      "algorithm": "knapsack_01",
      "name": "0/1 Knapsack",
      "complexity": "O(n * W)",
      "items": [
        {"weight": 1, "value": 1},
        {"weight": 3, "value": 4},
        {"weight": 4, "value": 5},
        {"weight": 5, "value": 7}
      ],
      "capacity": 7,
      "steps": [
        {
          "step": 1,
          "description": "Initialize 5x8 DP table",
          "action": "init",
          "rows": 5,
          "cols": 8,
          "visual_note": "Grid of tiles, row 0 and col 0 are zeros"
        },
        {
          "step": 2,
          "description": "Item 0 (w=1, v=1), capacity 1: include",
          "action": "fill",
          "cell": [1, 1],
          "value": 1,
          "choice": "include",
          "visual_note": "Diagonal arrow from (0,0)"
        },
        {
          "step": 3,
          "description": "Item 1 (w=3, v=4), capacity 3: include",
          "action": "fill",
          "cell": [2, 3],
          "value": 4,
          "choice": "include",
          "visual_note": "Value jumps to 4"
        },
        {
          "step": 4,
          "description": "Item 1, capacity 4: include (1+4=5)",
          "action": "fill",
          "cell": [2, 4],
          "value": 5,
          "choice": "include",
          "visual_note": "Item 0 + Item 1"
        },
        {
          "step": 5,
          "description": "Continue filling table...",
          "action": "fill_batch",
          "visual_note": "Tiles light up row by row"
        },
        {
          "step": 6,
          "description": "Final cell: maximum value = 9",
          "action": "fill",
          "cell": [4, 7],
          "value": 9,
          "visual_note": "Bottom-right glows brightest"
        },
        {
          "step": 7,
          "description": "Backtrack: Items 1 and 2 selected",
          "action": "backtrack",
          "path": [[4, 7], [3, 7], [2, 3], [1, 0]],
          "selected_items": [1, 2],
          "visual_note": "Path highlighted in gold"
        },
        {
          "step": 8,
          "description": "Complete: Max value 9, items [1, 2]",
          "action": "complete",
          "result": 9,
          "selected": [1, 2],
          "visual_note": "Selected items highlighted"
        }
      ]
    },
    {
      "algorithm": "lcs",
      "name": "Longest Common Subsequence",
      "complexity": "O(m * n)",
      "s1": "ABCDGH",
      "s2": "AEDFHR",
      "steps": [
        {
          "step": 1,
          "description": "Initialize 7x7 grid",
          "action": "init",
          "rows": ["", "A", "B", "C", "D", "G", "H"],
          "cols": ["", "A", "E", "D", "F", "H", "R"],
          "visual_note": "Grid with string labels"
        },
        {
          "step": 2,
          "description": "A vs A: match! LCS = 1",
          "action": "match",
          "cell": [1, 1],
          "value": 1,
          "char": "A",
          "visual_note": "Green diagonal arrow"
        },
        {
          "step": 3,
          "description": "B vs A: no match, max(left, above) = 1",
          "action": "no_match",
          "cell": [2, 1],
          "value": 1,
          "visual_note": "Vertical arrow from above"
        },
        {
          "step": 4,
          "description": "D vs D: match! LCS = 2",
          "action": "match",
          "cell": [4, 3],
          "value": 2,
          "char": "D",
          "visual_note": "Green diagonal arrow"
        },
        {
          "step": 5,
          "description": "H vs H: match! LCS = 3",
          "action": "match",
          "cell": [6, 5],
          "value": 3,
          "char": "H",
          "visual_note": "Green diagonal arrow"
        },
        {
          "step": 6,
          "description": "Final cell: LCS length = 3",
          "action": "fill",
          "cell": [6, 6],
          "value": 3,
          "visual_note": "Bottom-right shows 3"
        },
        {
          "step": 7,
          "description": "Backtrack to find LCS: ADH",
          "action": "backtrack",
          "path": [[6, 6], [6, 5], [4, 3], [1, 1]],
          "lcs": "ADH",
          "visual_note": "Path highlighted, LCS revealed"
        },
        {
          "step": 8,
          "description": "Complete: LCS = 'ADH', length = 3",
          "action": "complete",
          "result": 3,
          "lcs": "ADH",
          "visual_note": "LCS characters highlighted in both strings"
        }
      ]
    },
    {
      "algorithm": "coin_change",
      "name": "Coin Change (Minimum Coins)",
      "complexity": "O(amount * coins)",
      "coins": [1, 3, 4],
      "amount": 6,
      "steps": [
        {
          "step": 1,
          "description": "Initialize DP array",
          "action": "init",
          "table": [0, "inf", "inf", "inf", "inf", "inf", "inf"],
          "visual_note": "Row of 7 tiles, only 0 filled"
        },
        {
          "step": 2,
          "description": "Amount 1: use coin 1, total = 1",
          "action": "fill",
          "cell": 1,
          "value": 1,
          "coin_used": 1,
          "table": [0, 1, "inf", "inf", "inf", "inf", "inf"],
          "visual_note": "Tile 1 shows 1 coin"
        },
        {
          "step": 3,
          "description": "Amount 2: use coin 1, total = 2",
          "action": "fill",
          "cell": 2,
          "value": 2,
          "coin_used": 1,
          "table": [0, 1, 2, "inf", "inf", "inf", "inf"],
          "visual_note": "Tile 2 shows 2 coins"
        },
        {
          "step": 4,
          "description": "Amount 3: use coin 3, total = 1",
          "action": "fill",
          "cell": 3,
          "value": 1,
          "coin_used": 3,
          "table": [0, 1, 2, 1, "inf", "inf", "inf"],
          "visual_note": "Coin 3 is better than 1+1+1"
        },
        {
          "step": 5,
          "description": "Amount 4: use coin 4, total = 1",
          "action": "fill",
          "cell": 4,
          "value": 1,
          "coin_used": 4,
          "table": [0, 1, 2, 1, 1, "inf", "inf"],
          "visual_note": "Coin 4 is optimal"
        },
        {
          "step": 6,
          "description": "Amount 5: use coin 4, total = 2",
          "action": "fill",
          "cell": 5,
          "value": 2,
          "coin_used": 4,
          "table": [0, 1, 2, 1, 1, 2, "inf"],
          "visual_note": "4 + 1 = 2 coins"
        },
        {
          "step": 7,
          "description": "Amount 6: use coin 3, total = 2",
          "action": "fill",
          "cell": 6,
          "value": 2,
          "coin_used": 3,
          "table": [0, 1, 2, 1, 1, 2, 2],
          "visual_note": "3 + 3 = 2 coins (optimal!)"
        },
        {
          "step": 8,
          "description": "Complete: Minimum coins = 2",
          "action": "complete",
          "result": 2,
          "coins_used": [3, 3],
          "visual_note": "Greedy would give 3 coins [4,1,1]"
        }
      ]
    },
    {
      "algorithm": "edit_distance",
      "name": "Edit Distance",
      "complexity": "O(m * n)",
      "s1": "HORSE",
      "s2": "ROS",
      "steps": [
        {
          "step": 1,
          "description": "Initialize 6x4 grid",
          "action": "init",
          "rows": ["", "H", "O", "R", "S", "E"],
          "cols": ["", "R", "O", "S"],
          "base_row": [0, 1, 2, 3],
          "base_col": [0, 1, 2, 3, 4, 5],
          "visual_note": "Grid with base cases filled"
        },
        {
          "step": 2,
          "description": "H vs R: replace, cost = 1",
          "action": "edit",
          "cell": [1, 1],
          "value": 1,
          "operation": "replace",
          "visual_note": "Yellow diagonal arrow"
        },
        {
          "step": 3,
          "description": "O vs O: match, cost = 1",
          "action": "match",
          "cell": [2, 2],
          "value": 1,
          "operation": "match",
          "visual_note": "Green diagonal arrow"
        },
        {
          "step": 4,
          "description": "R vs R: match, cost = 1",
          "action": "match",
          "cell": [3, 1],
          "value": 1,
          "operation": "match",
          "visual_note": "Green diagonal"
        },
        {
          "step": 5,
          "description": "Continue filling...",
          "action": "fill_batch",
          "visual_note": "Tiles fill row by row"
        },
        {
          "step": 6,
          "description": "Final cell: edit distance = 3",
          "action": "fill",
          "cell": [5, 3],
          "value": 3,
          "visual_note": "Bottom-right shows 3"
        },
        {
          "step": 7,
          "description": "Backtrack: Replace H→R, Delete R, Delete E",
          "action": "backtrack",
          "operations": [
            {"op": "replace", "from": "H", "to": "R"},
            {"op": "match", "char": "O"},
            {"op": "delete", "char": "R"},
            {"op": "match", "char": "S"},
            {"op": "delete", "char": "E"}
          ],
          "visual_note": "Transformation path shown"
        },
        {
          "step": 8,
          "description": "Complete: HORSE → ROS in 3 edits",
          "action": "complete",
          "result": 3,
          "visual_note": "Transformation animated"
        }
      ]
    },
    {
      "algorithm": "lis",
      "name": "Longest Increasing Subsequence",
      "complexity": "O(n²)",
      "array": [10, 9, 2, 5, 3, 7, 101, 18],
      "steps": [
        {
          "step": 1,
          "description": "Initialize LIS array",
          "action": "init",
          "array": [10, 9, 2, 5, 3, 7, 101, 18],
          "dp": [1, 1, 1, 1, 1, 1, 1, 1],
          "visual_note": "Bar chart with LIS=1 for all"
        },
        {
          "step": 2,
          "description": "Index 3 (5): 2 < 5, extend LIS",
          "action": "extend",
          "index": 3,
          "value": 5,
          "from_index": 2,
          "dp": [1, 1, 1, 2, 1, 1, 1, 1],
          "visual_note": "Arrow from 2 to 5"
        },
        {
          "step": 3,
          "description": "Index 4 (3): 2 < 3, extend LIS",
          "action": "extend",
          "index": 4,
          "value": 3,
          "from_index": 2,
          "dp": [1, 1, 1, 2, 2, 1, 1, 1],
          "visual_note": "Arrow from 2 to 3"
        },
        {
          "step": 4,
          "description": "Index 5 (7): extend from 5 or 3",
          "action": "extend",
          "index": 5,
          "value": 7,
          "from_index": 3,
          "dp": [1, 1, 1, 2, 2, 3, 1, 1],
          "visual_note": "LIS = 3 via 2→5→7"
        },
        {
          "step": 5,
          "description": "Index 6 (101): extend from 7",
          "action": "extend",
          "index": 6,
          "value": 101,
          "from_index": 5,
          "dp": [1, 1, 1, 2, 2, 3, 4, 1],
          "visual_note": "LIS = 4 via 2→5→7→101"
        },
        {
          "step": 6,
          "description": "Index 7 (18): extend from 7",
          "action": "extend",
          "index": 7,
          "value": 18,
          "from_index": 5,
          "dp": [1, 1, 1, 2, 2, 3, 4, 4],
          "visual_note": "LIS = 4 via 2→5→7→18"
        },
        {
          "step": 7,
          "description": "Complete: LIS length = 4",
          "action": "complete",
          "result": 4,
          "one_lis": [2, 5, 7, 101],
          "visual_note": "One valid LIS highlighted"
        }
      ]
    }
  ]
}
