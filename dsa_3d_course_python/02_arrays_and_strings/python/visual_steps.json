{
  "world": "02_arrays_and_strings",
  "algorithms": [
    {
      "algorithm": "array_access",
      "description": "O(1) array index access demonstration",
      "input": {"array": [10, 20, 30, 40, 50, 60, 70, 80], "index": 5},
      "steps": [
        {"step": 1, "description": "Display array corridor with 8 tiles", "array_state": [10, 20, 30, 40, 50, 60, 70, 80], "action": "show_array"},
        {"step": 2, "description": "User requests access to index 5", "target_index": 5, "action": "highlight_request"},
        {"step": 3, "description": "Instant beam illuminates tile 5", "focus_indices": [5], "action": "access_beam"},
        {"step": 4, "description": "Display value 60 and O(1) label", "value": 60, "complexity": "O(1)", "action": "show_result"}
      ]
    },
    {
      "algorithm": "linear_search",
      "description": "O(n) linear search through array",
      "input": {"array": [5, 2, 8, 1, 9, 3, 7], "target": 9},
      "steps": [
        {"step": 1, "description": "Initialize search for target 9", "array_state": [5, 2, 8, 1, 9, 3, 7], "target": 9, "action": "initialize"},
        {"step": 2, "description": "Check index 0: 5 != 9", "focus_indices": [0], "comparison": "5 != 9", "match": false, "action": "compare"},
        {"step": 3, "description": "Check index 1: 2 != 9", "focus_indices": [1], "comparison": "2 != 9", "match": false, "action": "compare"},
        {"step": 4, "description": "Check index 2: 8 != 9", "focus_indices": [2], "comparison": "8 != 9", "match": false, "action": "compare"},
        {"step": 5, "description": "Check index 3: 1 != 9", "focus_indices": [3], "comparison": "1 != 9", "match": false, "action": "compare"},
        {"step": 6, "description": "Check index 4: 9 == 9 FOUND!", "focus_indices": [4], "comparison": "9 == 9", "match": true, "action": "found"},
        {"step": 7, "description": "Return index 4", "result_index": 4, "operations": 5, "action": "complete"}
      ]
    },
    {
      "algorithm": "two_pointer_reverse",
      "description": "Reverse array in-place using two pointers",
      "input": {"array": ["R", "E", "V", "E", "R", "S", "E"]},
      "steps": [
        {"step": 1, "description": "Initialize pointers at ends", "array_state": ["R", "E", "V", "E", "R", "S", "E"], "left": 0, "right": 6, "action": "initialize"},
        {"step": 2, "description": "Swap indices 0 and 6: R <-> E", "focus_indices": [0, 6], "action": "swap"},
        {"step": 3, "description": "After swap", "array_state": ["E", "E", "V", "E", "R", "S", "R"], "left": 1, "right": 5, "action": "move_pointers"},
        {"step": 4, "description": "Swap indices 1 and 5: E <-> S", "focus_indices": [1, 5], "action": "swap"},
        {"step": 5, "description": "After swap", "array_state": ["E", "S", "V", "E", "R", "E", "R"], "left": 2, "right": 4, "action": "move_pointers"},
        {"step": 6, "description": "Swap indices 2 and 4: V <-> R", "focus_indices": [2, 4], "action": "swap"},
        {"step": 7, "description": "After swap", "array_state": ["E", "S", "R", "E", "V", "E", "R"], "left": 3, "right": 3, "action": "move_pointers"},
        {"step": 8, "description": "Pointers crossed - reversal complete", "array_state": ["E", "S", "R", "E", "V", "E", "R"], "action": "complete"}
      ]
    },
    {
      "algorithm": "sliding_window_sum",
      "description": "Calculate sum of sliding window of size k",
      "input": {"array": [2, 1, 5, 1, 3, 2], "k": 3},
      "steps": [
        {"step": 1, "description": "Initialize window [0:3]", "array_state": [2, 1, 5, 1, 3, 2], "window_start": 0, "window_end": 2, "window_sum": 8, "action": "initial_window"},
        {"step": 2, "description": "Slide window: remove 2, add 1", "window_start": 1, "window_end": 3, "leaving": 2, "entering": 1, "window_sum": 7, "action": "slide"},
        {"step": 3, "description": "Slide window: remove 1, add 3", "window_start": 2, "window_end": 4, "leaving": 1, "entering": 3, "window_sum": 9, "max_so_far": 9, "action": "slide"},
        {"step": 4, "description": "Slide window: remove 5, add 2", "window_start": 3, "window_end": 5, "leaving": 5, "entering": 2, "window_sum": 6, "action": "slide"},
        {"step": 5, "description": "Window reached end - maximum sum was 9", "max_sum": 9, "max_window": [5, 1, 3], "action": "complete"}
      ]
    },
    {
      "algorithm": "two_sum",
      "description": "Find two numbers that sum to target using hash map",
      "input": {"array": [2, 7, 11, 15], "target": 9},
      "steps": [
        {"step": 1, "description": "Initialize hash map, target = 9", "array_state": [2, 7, 11, 15], "hash_map": {}, "action": "initialize"},
        {"step": 2, "description": "Process index 0: value=2, complement=7, not in map", "focus_indices": [0], "value": 2, "complement": 7, "found": false, "action": "check_and_store"},
        {"step": 3, "description": "Store 2 -> 0 in hash map", "hash_map": {"2": 0}, "action": "store"},
        {"step": 4, "description": "Process index 1: value=7, complement=2, FOUND in map!", "focus_indices": [0, 1], "value": 7, "complement": 2, "found": true, "action": "found"},
        {"step": 5, "description": "Return indices (0, 1): 2 + 7 = 9", "result": [0, 1], "action": "complete"}
      ]
    },
    {
      "algorithm": "string_concatenation",
      "description": "Demonstrate string immutability during concatenation",
      "input": {"str_a": "HELLO", "str_b": "WORLD"},
      "steps": [
        {"step": 1, "description": "Create string A: 'HELLO'", "string": "HELLO", "memory_id": "A001", "action": "create_string"},
        {"step": 2, "description": "Create string B: 'WORLD'", "string": "WORLD", "memory_id": "B002", "action": "create_string"},
        {"step": 3, "description": "Concatenate A + B", "operation": "concatenation", "action": "start_concat"},
        {"step": 4, "description": "NEW string created: 'HELLOWORLD'", "string": "HELLOWORLD", "memory_id": "C003", "new_object": true, "action": "create_result"},
        {"step": 5, "description": "Original strings unchanged", "originals": [{"string": "HELLO", "memory_id": "A001"}, {"string": "WORLD", "memory_id": "B002"}], "action": "verify_immutability"}
      ]
    },
    {
      "algorithm": "array_insert",
      "description": "Insert element in middle of array showing O(n) shift",
      "input": {"array": [10, 20, 30, 40, 50, 60, 70, 80], "index": 3, "value": 35},
      "steps": [
        {"step": 1, "description": "Array before insertion", "array_state": [10, 20, 30, 40, 50, 60, 70, 80], "action": "show_initial"},
        {"step": 2, "description": "Insert 35 at index 3", "insert_index": 3, "insert_value": 35, "action": "start_insert"},
        {"step": 3, "description": "Shift element at index 7 to index 8", "shift_from": 7, "shift_to": 8, "value": 80, "action": "shift"},
        {"step": 4, "description": "Shift element at index 6 to index 7", "shift_from": 6, "shift_to": 7, "value": 70, "action": "shift"},
        {"step": 5, "description": "Shift element at index 5 to index 6", "shift_from": 5, "shift_to": 6, "value": 60, "action": "shift"},
        {"step": 6, "description": "Shift element at index 4 to index 5", "shift_from": 4, "shift_to": 5, "value": 50, "action": "shift"},
        {"step": 7, "description": "Shift element at index 3 to index 4", "shift_from": 3, "shift_to": 4, "value": 40, "action": "shift"},
        {"step": 8, "description": "Place 35 at index 3", "place_index": 3, "place_value": 35, "action": "place"},
        {"step": 9, "description": "Insertion complete - 5 elements shifted", "array_state": [10, 20, 30, 35, 40, 50, 60, 70, 80], "elements_shifted": 5, "complexity": "O(n)", "action": "complete"}
      ]
    }
  ]
}
