{
  "world": "14_advanced_structures_tries_segment_fenwick",
  "description": "Visualization steps for advanced data structures",
  "algorithms": [
    {
      "algorithm": "trie_insert",
      "name": "Trie Insert Operation",
      "complexity": "O(m)",
      "word": "apple",
      "steps": [
        {
          "step": 1,
          "description": "Start inserting 'apple'",
          "action": "init",
          "word": "apple",
          "visual_note": "Root node highlighted"
        },
        {
          "step": 2,
          "description": "Create node for 'a'",
          "action": "create_node",
          "character": "a",
          "path": "a",
          "visual_note": "New node 'a' appears"
        },
        {
          "step": 3,
          "description": "Create node for 'p'",
          "action": "create_node",
          "character": "p",
          "path": "ap",
          "visual_note": "Node 'p' branches from 'a'"
        },
        {
          "step": 4,
          "description": "Create node for 'p'",
          "action": "create_node",
          "character": "p",
          "path": "app",
          "visual_note": "Second 'p' node"
        },
        {
          "step": 5,
          "description": "Create node for 'l'",
          "action": "create_node",
          "character": "l",
          "path": "appl",
          "visual_note": "Node 'l' added"
        },
        {
          "step": 6,
          "description": "Create node for 'e'",
          "action": "create_node",
          "character": "e",
          "path": "apple",
          "visual_note": "Final node 'e'"
        },
        {
          "step": 7,
          "description": "Mark 'apple' as word end",
          "action": "mark_end",
          "path": "apple",
          "is_word_end": true,
          "visual_note": "Gold ring on 'e' node"
        }
      ]
    },
    {
      "algorithm": "trie_search",
      "name": "Trie Search Operation",
      "complexity": "O(m)",
      "word": "app",
      "trie_contains": ["apple", "app", "application"],
      "steps": [
        {
          "step": 1,
          "description": "Search for 'app'",
          "action": "init",
          "word": "app",
          "visual_note": "Start at root"
        },
        {
          "step": 2,
          "description": "Follow edge 'a'",
          "action": "traverse",
          "character": "a",
          "path": "a",
          "visual_note": "Path glows cyan"
        },
        {
          "step": 3,
          "description": "Follow edge 'p'",
          "action": "traverse",
          "character": "p",
          "path": "ap",
          "visual_note": "Continue on path"
        },
        {
          "step": 4,
          "description": "Follow edge 'p'",
          "action": "traverse",
          "character": "p",
          "path": "app",
          "visual_note": "Reach 'app' node"
        },
        {
          "step": 5,
          "description": "Check if word end",
          "action": "check_end",
          "is_word_end": true,
          "visual_note": "Node has gold ring - FOUND!"
        }
      ]
    },
    {
      "algorithm": "segment_tree_build",
      "name": "Segment Tree Build",
      "complexity": "O(n)",
      "array": [1, 3, 5, 7, 9, 11],
      "steps": [
        {
          "step": 1,
          "description": "Build segment tree for [1, 3, 5, 7, 9, 11]",
          "action": "init",
          "array": [1, 3, 5, 7, 9, 11],
          "visual_note": "Array displayed as base"
        },
        {
          "step": 2,
          "description": "Create leaf nodes",
          "action": "create_leaves",
          "leaves": [1, 3, 5, 7, 9, 11],
          "visual_note": "Leaf nodes above array"
        },
        {
          "step": 3,
          "description": "Build level 2: [4, 12, 20]",
          "action": "build_level",
          "level": 2,
          "nodes": [
            {"range": [0, 1], "value": 4},
            {"range": [2, 3], "value": 12},
            {"range": [4, 5], "value": 20}
          ],
          "visual_note": "Sum pairs of leaves"
        },
        {
          "step": 4,
          "description": "Build level 1: [16, 20]",
          "action": "build_level",
          "level": 1,
          "nodes": [
            {"range": [0, 3], "value": 16},
            {"range": [4, 5], "value": 20}
          ],
          "visual_note": "Continue building up"
        },
        {
          "step": 5,
          "description": "Build root: [36]",
          "action": "build_root",
          "range": [0, 5],
          "value": 36,
          "visual_note": "Root covers entire array"
        }
      ]
    },
    {
      "algorithm": "segment_tree_query",
      "name": "Segment Tree Range Query",
      "complexity": "O(log n)",
      "array": [1, 3, 5, 7, 9, 11],
      "query": [1, 4],
      "steps": [
        {
          "step": 1,
          "description": "Query sum[1, 4]",
          "action": "init",
          "query_range": [1, 4],
          "visual_note": "Highlight query range on array"
        },
        {
          "step": 2,
          "description": "Start at root [0-5]",
          "action": "visit_node",
          "node_range": [0, 5],
          "value": 36,
          "overlap": "partial",
          "visual_note": "Root partially overlaps query"
        },
        {
          "step": 3,
          "description": "Check left child [0-2]",
          "action": "visit_node",
          "node_range": [0, 2],
          "overlap": "partial",
          "visual_note": "Partial overlap, go deeper"
        },
        {
          "step": 4,
          "description": "Check [0-1]: partial",
          "action": "visit_node",
          "node_range": [0, 1],
          "overlap": "partial",
          "visual_note": "Only index 1 in query"
        },
        {
          "step": 5,
          "description": "Get leaf [1] = 3",
          "action": "get_value",
          "node_range": [1, 1],
          "value": 3,
          "visual_note": "Add 3 to result"
        },
        {
          "step": 6,
          "description": "Get [2] = 5 (full overlap)",
          "action": "get_value",
          "node_range": [2, 2],
          "value": 5,
          "visual_note": "Add 5 to result"
        },
        {
          "step": 7,
          "description": "Check right child [3-5]",
          "action": "visit_node",
          "node_range": [3, 5],
          "overlap": "partial",
          "visual_note": "Partial overlap"
        },
        {
          "step": 8,
          "description": "Get [3-4] = 16 (full overlap)",
          "action": "get_value",
          "node_range": [3, 4],
          "value": 16,
          "visual_note": "Add 16 to result"
        },
        {
          "step": 9,
          "description": "Result: 3 + 5 + 16 = 24",
          "action": "complete",
          "result": 24,
          "visual_note": "Query complete"
        }
      ]
    },
    {
      "algorithm": "fenwick_update",
      "name": "Fenwick Tree Update",
      "complexity": "O(log n)",
      "size": 10,
      "update_index": 3,
      "delta": 5,
      "steps": [
        {
          "step": 1,
          "description": "Update index 3 by +5",
          "action": "init",
          "index": 3,
          "delta": 5,
          "visual_note": "Start at position 3"
        },
        {
          "step": 2,
          "description": "Update BIT[4] (1-indexed)",
          "action": "update_position",
          "index": 4,
          "binary": "0100",
          "lsb": 4,
          "next": 8,
          "visual_note": "4 + LSB(4) = 8"
        },
        {
          "step": 3,
          "description": "Update BIT[8]",
          "action": "update_position",
          "index": 8,
          "binary": "1000",
          "lsb": 8,
          "next": 16,
          "visual_note": "8 + LSB(8) = 16 > 10, stop"
        },
        {
          "step": 4,
          "description": "Update complete",
          "action": "complete",
          "positions_updated": [4, 8],
          "visual_note": "Two positions updated"
        }
      ]
    },
    {
      "algorithm": "fenwick_query",
      "name": "Fenwick Tree Prefix Sum",
      "complexity": "O(log n)",
      "size": 10,
      "query_index": 7,
      "steps": [
        {
          "step": 1,
          "description": "Query prefix sum [0, 7]",
          "action": "init",
          "index": 7,
          "visual_note": "Start at position 7"
        },
        {
          "step": 2,
          "description": "Add BIT[8] (1-indexed)",
          "action": "add_value",
          "index": 8,
          "binary": "1000",
          "lsb": 8,
          "next": 0,
          "visual_note": "8 - LSB(8) = 0, stop"
        },
        {
          "step": 3,
          "description": "Query complete",
          "action": "complete",
          "positions_queried": [8],
          "visual_note": "Single position covers entire range"
        }
      ]
    }
  ]
}
